# Core server
PORT=8000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# PostgreSQL
# Use your Postgres base URL; the app will use the database in the URL if present,
# or fall back to /postgres.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
DATABASE_SSL=false

# Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-secret

# ML service
ML_SERVICE_URL=http://localhost:5000

# Optional voice stack later
# VOICE_INTERNAL_KEY=replace-with-a-shared-secret