*.h5
*.joblib
*.onnx
__pycache__/
*.pyc
*.pyo

# ─── Python dev artefacts ────────────────────────────────────
.python-version
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/

# ─── Logs ────────────────────────────────────────────────────
logs/
*.log
pids/
*.pid

# ─── Database / secrets ──────────────────────────────────────
*.sqlite
*.sqlite3
*.db

# ─── Testing / coverage ──────────────────────────────────────
coverage/
.nyc_output/

